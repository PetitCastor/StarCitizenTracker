# Visual Studio
.vs/
*.user
*.rsuser
*.suo
*.sln.docstates

# Build directories
bin/
obj/
Debug/
Release/
TestResults/

# `dotnet pack -o` output. The packages are build products of a tagged commit; the release
# pipeline publishes them to a feed, nothing here should carry them.
artifacts/
*.nupkg
*.snupkg

# Runtime output
captures/

# Dependencies
packages/
.nuget/

# IDE
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local user settings
*.local.json
local.config

# Local-only docs/notes — working plans and session notes stay out of the repo.
/tasks/
/*.md
.rtk/

# ...except the README: the release ships three interdependent exes (engine first, matching
# pipe name), and a clone or a release download has nowhere else to learn that.
!/README.md
