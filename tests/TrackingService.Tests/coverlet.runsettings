<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes files that are pure OS/hardware interop (Win32 capture, keyboard hook thread,
  WinRT OCR engine calls, file/JSON I/O) from the coverage gate. These have no branching
  business logic worth pinning with unit tests and can't run without a live display/OCR
  engine; they're verified manually and via the replay-mode regression tests instead. Each
  excluded file's pure static helper (if any) is still unit tested directly; excluding the
  file only affects the aggregate coverage percentage, not whether that helper gets tested.

  Usage: dotnet test, with flags "settings coverlet.runsettings" and "collect:XPlat Code Coverage"
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>
            **/Core/CaptureInterop.cs,
            **/Core/MonitorCapture.cs,
            **/Core/FrameSaver.cs,
            **/Core/ProbeConfig.cs,
            **/Trackers/TrackerHost.cs,
            **/Trackers/FrameDumpTracker.cs,
            **/Program.cs
          </ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
