<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0, like the plugin under test: if this project ever needed a Windows TFM to
       compile, the plugin would have grown a dependency on the capture stack. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Plugins\MissionPlugin\MissionPlugin.csproj" />
    <ProjectReference Include="..\..\src\GameCapture.Sdk\GameCapture.Sdk.csproj" />
    <!-- Ticks are built through GameCapture.Sdk.Testing's public TickDataBuilder now, not the wire
         type directly, but RoiRect (Rois.Pane.Rect assertions) still comes from here. -->
    <ProjectReference Include="..\..\src\GameCapture.Contracts\GameCapture.Contracts.csproj" />
    <ProjectReference Include="..\..\src\GameCapture.Sdk.Testing\GameCapture.Sdk.Testing.csproj" />
  </ItemGroup>

  <!-- The mission-accept corpus ReplayParityTests awaits (TASK-13): wired ahead of the capture so
       landing the PNGs under tests\fixtures\corpus\mission-accept is enough to unskip the test,
       with no further csproj change. An empty glob until then is harmless. -->
  <ItemGroup>
    <None Include="..\fixtures\corpus\mission-accept\**\*.png" Link="Fixtures\Replay\mission-accept\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
