<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0, deliberately: this is the library every plugin references, and a Windows
       TFM here would let a WinRT type leak into a plugin and quietly re-couple it to the
       capture stack the split exists to isolate. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Ship the XML docs. Without this the doc comments on IGameCapturePlugin, TickData and
         RoiErrorPolicy exist only in this repository, and a package consumer (who by definition
         cannot read the source) gets bare signatures in IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing comment on a public member) stays off. The aim is to ship the docs that
         exist, which is most of the surface a plugin author touches; turning every undocumented
         property on a value type into a build error under TreatWarningsAsErrors would be a
         documentation project, not a packaging one. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>GameCapture.Sdk</PackageId>
    <Description>Client SDK for writing GameCapture plugins. Implement IGameCapturePlugin — a name, a set of screen regions, and what to do with one frame's OCR results — and hand it to GameCapturePluginHost, which owns connecting, subscribing, reconnecting, and shutdown.</Description>
    <PackageTags>star-citizen;screen-capture;ocr;plugin;sdk;grpc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameCapture.Contracts\GameCapture.Contracts.csproj" />
  </ItemGroup>

  <!-- Google.Protobuf and Grpc.Core.Api arrive transitively via GameCapture.Contracts; this adds the
       client-side channel implementation the generated stub needs. -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
  </ItemGroup>

  <!-- The SDK is exercised end to end from the engine test project (TASK-4 and TASK-7): those
       tests own an in-proc engine, so they are the only place the client can be driven against
       the real transport without a second process. -->
  <ItemGroup>
    <!-- The SDK's own suite: the plugin host's seams (argument parsing, the FrameSeq gap tracker,
         the ROI-failure latch) are internal because they are not a plugin's business, and they are
         also where the host's decisions actually live. -->
    <InternalsVisibleTo Include="GameCapture.Sdk.Tests" />
    <InternalsVisibleTo Include="GameCapture.Engine.Tests" />
    <!-- GameCapture.Sdk.Testing ships in this repo alongside the SDK, so unlike a plugin's own test
         project it still has InternalsVisibleTo once the engine/plugins split into separate repos
         (TASK-22/23) — the reason it, not a plugin-test grant, is the one meant to last. Both
         plugin suites now build ticks through its public TickDataBuilder (MissionPlugin in TASK-10,
         RefineryPlugin in TASK-11), so no plugin-test grant remains here. -->
    <InternalsVisibleTo Include="GameCapture.Sdk.Testing" />
  </ItemGroup>

</Project>
