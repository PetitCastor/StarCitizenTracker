<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0, deliberately: this is the library every plugin references, and a Windows
       TFM here would let a WinRT type leak into a plugin and quietly re-couple it to the
       capture stack the split exists to isolate. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaptureContracts\CaptureContracts.csproj" />
  </ItemGroup>

  <!-- Google.Protobuf and Grpc.Core.Api arrive transitively via CaptureContracts; this adds the
       client-side channel implementation the generated stub needs. -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
  </ItemGroup>

  <!-- The SDK is exercised end to end from the engine test project (TASK-4 and TASK-7): those
       tests own an in-proc engine, so they are the only place the client can be driven against
       the real transport without a second process. -->
  <ItemGroup>
    <!-- The SDK's own suite: the plugin host's seams (argument parsing, the FrameSeq gap tracker,
         the ROI-failure latch) are internal because they are not a plugin's business, and they are
         also where the host's decisions actually live. -->
    <InternalsVisibleTo Include="TrackerSdk.Tests" />
    <InternalsVisibleTo Include="CaptureEngine.Tests" />
    <!-- Plugin suites build ticks from the wire type the engine would have sent, which is what
         TickData.From maps: the alternative is a public factory that exists only for tests and
         that a plugin could then call in production code. Dies in TASK-10/11 once both plugins'
         suites move onto TrackerSdk.Testing, the grant that survives a repo split. -->
    <InternalsVisibleTo Include="MissionPlugin.Tests" />
    <InternalsVisibleTo Include="RefineryPlugin.Tests" />
    <!-- TrackerSdk.Testing ships in this repo alongside the SDK, so unlike a plugin's own test
         project it still has InternalsVisibleTo once the engine/plugins split into separate repos
         (TASK-22/23) — the reason it, not a plugin-test grant, is the one meant to last. -->
    <InternalsVisibleTo Include="TrackerSdk.Testing" />
  </ItemGroup>

</Project>
