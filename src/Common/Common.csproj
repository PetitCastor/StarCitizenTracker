<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Common</RootNamespace>
  </PropertyGroup>

  <!-- ConsoleSink.FitToWidth is internal on purpose — truncating to the console width is an
       implementation detail of the status line, not something a caller should reach for — but it
       is also the only branching logic in this project, so its tests need the seam. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Common.Tests" />
  </ItemGroup>

</Project>
