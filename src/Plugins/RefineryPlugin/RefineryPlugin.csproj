<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0: a plugin owns parsing and nothing else, so it must not be able to reach a
       WinRT type. The Windows TFM stops at the engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RefineryPlugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CaptureContracts\CaptureContracts.csproj" />
    <ProjectReference Include="..\..\Common\Common.csproj" />
    <ProjectReference Include="..\..\TrackerSdk\TrackerSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RefineryPlugin.Tests" />
    <!-- The replay-parity tests (ENGINE-SPLIT TASK-7) run the engine, the SDK and this plugin in
         one process, so they live with the engine's suite — the only project that can own both
         ends of the pipe — and drive RefineryRunner and the Rois set directly. -->
    <InternalsVisibleTo Include="CaptureEngine.Tests" />
  </ItemGroup>

</Project>
