<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0, like TrackerSdk itself: this is the companion package a plugin's own tests
       reference, and a Windows TFM here would defeat the reason it exists (see remarks below). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- InternalsVisibleTo cannot reach across a repo boundary, which is exactly where a
       third-party plugin's tests live once the split happens (TASK-22/23). This package is the
       `Microsoft.AspNetCore.Mvc.Testing`-style substitute: a public builder that only this
       assembly may reach TickData.From through. -->
  <ItemGroup>
    <ProjectReference Include="..\TrackerSdk\TrackerSdk.csproj" />
    <ProjectReference Include="..\CaptureContracts\CaptureContracts.csproj" />
  </ItemGroup>

</Project>
